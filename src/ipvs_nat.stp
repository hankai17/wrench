%{
	#include <net/tcp.h>
	#include <linux/rtc.h>
	#include <linux/timekeeping.h>
    #include <net/ip_vs.h>

%}

probe ipvs.ipvs_new =
    module("ip_vs").statement("ip_vs_schedule@net/netfilter/ipvs/ip_vs_core.c:537")
{
    print_stack(backtrace());
    do_schedule($skb, $dest);
}

function do_schedule(skb:long, dest:long)
%{
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;
    struct ip_vs_dest *dest = (struct ip_vs_dest *)STAP_ARG_dest;

    if ((!skb->dev || skb->dev->flags & IFF_LOOPBACK)) {
        printk("reverse\n");
    } else {
        printk("no reverse\n");
    }

    if (dest) {
        printk("ip_vs_schedule: get dest vaddr: %08X\n", ntohl(dest->vaddr.ip));
    } else {
        printk("ip_vs_schedule: get dest vaddr null\n");
    }
%}

probe ipvs.ipvs_new =
    module("ip_vs").function("ip_vs_conn_new").return 
{
	conn = $return
	if (!conn) next
    new_conn(conn)
}

function new_conn(conn:long)
%{
    struct ip_vs_conn * cp = (struct ip_vs_conn *)STAP_ARG_conn;
    printk("new cp->state: %d\n", cp->state);
    printk("new cp->pe_data: %s\n", cp->pe_data);
%}

probe ipvs.ipvs_nat = 
    module("ip_vs").statement("ip_vs_nat_xmit@net/netfilter/ipvs/ip_vs_xmit.c:801")
{
    sk = $skb->sk;
	addr = get_socket_addr(sk);
	do_ipvs_nat($skb, $cp, $rt, $local, addr)
}

function do_ipvs_nat(skb:long, cp:long, rt:long, local:long, addr:string)
%{
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;
    struct ip_vs_conn *cp = (struct ip_vs_conn *)STAP_ARG_cp;
    struct rtable *rt = (struct rtable *)STAP_ARG_rt;
    int local = (int)STAP_ARG_local;
    char *addr = (char *)STAP_ARG_addr;

    printk("addr: %s\n", addr);

    printk("ip_vs_nat_xmit find rt, \
                rt->type: %d, \
                gentid: %d, \
                iif: %d, \
                gateway: %d, \
                dev: %s, \
                dst->dev->ifindex: %d\n", 
        rt->rt_type, 
        rt->rt_genid, 
        rt->rt_iif,
        rt->rt_gw4,
        rt->dst.dev->name,
        rt->dst.dev->ifindex);
%}

// 数据包进入四层了吗?
// 为什么进邻居子系统?

probe ipvs.ipvs_nat_send = 
    module("ip_vs").function("ip_vs_nat_send_or_cont")
{
	do_nat_send($skb)
}

function do_nat_send(skb:long)
%{
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;

%}


