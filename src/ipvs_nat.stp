probe ipvs.ip_output =
    kernel.function("ip_output")
{
    if (!$skb) next;

    sk = $skb->sk;
    if (!sk) next;

    info = sk->sk_user_data;
    if (!info) next;

    tcphdr = __get_skb_tcphdr($skb);
    if (!tcphdr) next;

    sport = __tcp_skb_sport(tcphdr);
    dport = __tcp_skb_dport(tcphdr);
    syn = __tcp_skb_syn(tcphdr);
    ack = __tcp_skb_ack(tcphdr); 
    fin = __tcp_skb_fin(tcphdr);
    rst = __tcp_skb_rst(tcphdr);
    urg = __tcp_skb_urg(tcphdr);
    
    seq = __tcp_skb_seq(tcphdr);
    ack_seq = __tcp_skb_ackseq(tcphdr);
    
    printf("ip_output: sport: %d, dport: %d,"
            " syn: %d, ack: %d, fin: %d, rst: %d, urg: %d,"
            " skb->len: %d"
            //" seq: %d, ack_seq: %d"
            "\n",
            sport, dport,
            syn, ack, fin, rst, urg,
            $skb->data_len
            //seq, ack_seq
    );
}

