%{
	#include <net/tcp.h>
	#include <linux/rtc.h>
	#include <linux/timekeeping.h>
    #include <net/ip_vs.h>

%}

probe ipvs.ipvs_start =
    module("ip_vs").function("ip_vs_schedule")
{
    if (!$skb) next;
    sk = $skb->sk; 
    if (!sk) next;
    info = sk->sk_user_data;
    if (!info) next;
    printf("ip_vs_schedule start\n"); 
}

probe ipvs.ipvs_conn_find =
    module("ip_vs").statement("ip_vs_schedule@net/netfilter/ipvs/ip_vs_core.c:532")
{
    printf("%s",
        ipvs_conn_find($dest)
    );
}

function ipvs_conn_find:string (dest:long)
%{
    struct ip_vs_dest* dest = (struct ip_vs_dest*)STAP_ARG_dest;
    if (dest) {
        sprintf(STAP_RETVALUE, "%s", "dest match\n");
    } else {
        sprintf(STAP_RETVALUE, "%s", "dest not match\n");
    }
%}

probe ipvs.ipvs_schedule =
    module("ip_vs").statement("ip_vs_schedule@net/netfilter/ipvs/ip_vs_core.c:547")
{
    //print_stack(backtrace());
    if ($skb) {
        sk = $skb->sk;
        if (sk) {
	        if (mem_alloc(sk)) {
	        	next
	        }
        } else {
            printf("sk in null\n");
        }
    } else {
        printf("skb in null\n");
    }
    printf("%s",
        do_schedule($skb)
    );
}

function do_schedule:string (skb:long)
%{
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;

    if ((!skb->dev || skb->dev->flags & IFF_LOOPBACK)) {
        sprintf(STAP_RETVALUE, "%s", "reverse\n");
    } else {
        sprintf(STAP_RETVALUE, "%s", "no reverse\n");
    }
%}

probe ipvs.ipvs_new =
    module("ip_vs").function("ip_vs_conn_new").return 
{
	conn = $return
	if (!conn) next;
    
    printf("new conn, state: %d\n", conn->state);
    print_stack(backtrace());
}

probe ipvs.ipvs_nat = 
    module("ip_vs").statement("ip_vs_nat_xmit@net/netfilter/ipvs/ip_vs_xmit.c:801")
{
    if (!$skb) next;
    sk = $skb->sk;
    if (!sk) next;
	addr = get_socket_addr(sk);
    
	printf("%s",
        do_ipvs_nat($skb, $cp, $rt, $local, addr)
    );
}

function do_ipvs_nat:string (skb:long, cp:long, rt:long, local:long, addr:string)
%{
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;
    struct ip_vs_conn *cp = (struct ip_vs_conn *)STAP_ARG_cp;
    struct rtable *rt = (struct rtable *)STAP_ARG_rt;
    int local = (int)STAP_ARG_local;
    char *addr = (char *)STAP_ARG_addr;

    sprintf(STAP_RETVALUE, "\nip_vs_nat_xmit addr: %s, find rtable, type: %d, gentid: %d, iif: %d, gateway: %d, dev: %s, dst->dev->ifindex: %d\n", 
        addr,
        rt->rt_type, 
        rt->rt_genid, 
        rt->rt_iif,
        rt->rt_gw4,
        rt->dst.dev->name,
        rt->dst.dev->ifindex);
%}

probe ipvs.tcp_recv =
    tcp.receive 
{
    if (!$skb) next;
    sk = $skb->sk; 
    if (!sk) next;
    info = sk->sk_user_data;
    if (!info) next;

    printf("tcp_v4_rcv saddr: %s, sport: %d, daddr: %s, dport: %d\n",
        saddr, sport,
        daddr, dport);
}

