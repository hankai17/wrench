%{
	#include <net/tcp.h>
	#include <linux/rtc.h>
	#include <linux/timekeeping.h>
    #include <net/ip_vs.h>

%}

probe ipvs.ipvs_conn_find =
    module("ip_vs").statement("ip_vs_schedule@net/netfilter/ipvs/ip_vs_core.c:532")
{
    ipvs_conn_find($dest)
}

function ipvs_conn_find(dest:long)
%{
    struct ip_vs_dest* dest = (struct ip_vs_dest*)STAP_ARG_dest;
    if (dest) {
        printk("dest match\n");
    } else {
        printk("dest not match\n");
    }
%}

probe ipvs.ipvs_schedule =
    module("ip_vs").statement("ip_vs_schedule@net/netfilter/ipvs/ip_vs_core.c:547")
{
    print_stack(backtrace());
    if ($skb) {
        sk = $skb->sk;
        if (sk) {
	        if (mem_alloc(sk)) {
	        	next
	        }
        } else {
            printf("sk in null\n");
        }
    } else {
        printf("skb in null\n");
    }
    do_schedule($skb);
}

function do_schedule(skb:long)
%{
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;

    if ((!skb->dev || skb->dev->flags & IFF_LOOPBACK)) {
        printk("reverse\n");
    } else {
        printk("no reverse\n");
    }
%}

probe ipvs.ipvs_new =
    module("ip_vs").function("ip_vs_conn_new").return 
{
	conn = $return
	if (!conn) next
    new_conn(conn)
}

function new_conn(conn:long)
%{
    struct ip_vs_conn * cp = (struct ip_vs_conn *)STAP_ARG_conn;
    printk("new cp->state: %d\n", cp->state);
    printk("new cp->pe_data: %s\n", cp->pe_data);
%}

probe ipvs.ipvs_nat = 
    module("ip_vs").statement("ip_vs_nat_xmit@net/netfilter/ipvs/ip_vs_xmit.c:801")
{
    sk = $skb->sk;
	addr = get_socket_addr(sk);
	do_ipvs_nat($skb, $cp, $rt, $local, addr)
}

function do_ipvs_nat(skb:long, cp:long, rt:long, local:long, addr:string)
%{
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;
    struct ip_vs_conn *cp = (struct ip_vs_conn *)STAP_ARG_cp;
    struct rtable *rt = (struct rtable *)STAP_ARG_rt;
    int local = (int)STAP_ARG_local;
    char *addr = (char *)STAP_ARG_addr;

    printk("ip_vs_nat_xmit addr: %s, find rtable, type: %d, gentid: %d, iif: %d, gateway: %d, dev: %s, dst->dev->ifindex: %d\n", 
        addr,
        rt->rt_type, 
        rt->rt_genid, 
        rt->rt_iif,
        rt->rt_gw4,
        rt->dst.dev->name,
        rt->dst.dev->ifindex);
%}

probe ipvs.tcp_recv =
    tcp.receive 
{
    do_l4_start1(skb, saddr, daddr, sport, dport)
}

function do_l4_start1(skb:long, saddr:string, daddr:string, sport:long, dport:long)
%{
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;
    char *saddr = (char *)STAP_ARG_saddr;
    char *daddr = (char *)STAP_ARG_daddr;
    int sport = (int)STAP_ARG_sport;
    int dport = (int)STAP_ARG_dport;

    if (!skb) {
        return;
    }

	struct sock *sk = (struct sock *)skb->sk;
    if (!sk) {
        return;
    }

	struct stap_info *info = sk->sk_user_data;
	if (!info) {
		return;
    }

    printk("tcp_v4_rcv saddr: %s, sport: %d, daddr: %s, dport: %d\n",
        saddr, sport,
        daddr, dport);
%}

probe ipvs.l4_start =
    kernel.function("tcp_v4_rcv")
{
    sk = $skb->sk;
    if (sk) {
        do_l4_start(sk, $skb);
    }
}

function do_l4_start(sk:long, skb:long)
%{
	struct sock *sk = (struct sock *)STAP_ARG_sk;
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;

    int port = ntohs(inet_sk(sk)->inet_sport);
    if (port != 80) {
        return;
    }
    printk("dport: %d\n", port);
%}

probe ipvs.ipvs_nat_send = 
    module("ip_vs").function("ip_vs_nat_send_or_cont")
{
	do_nat_send($skb)
}

function do_nat_send(skb:long)
%{
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;
%}

probe ipvs.ip_output =
    kernel.function("ip_output")
{
    do_ip_output($sk, $skb);
}

function do_ip_output(sk:long, skb:long)
%{
	struct sock *sk = (struct sock *)STAP_ARG_sk;
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;

    if (!skb) {
        return;
    }

    //if (sk1 && inet_sk(sk1)) {
    //    int port = ntohs(inet_sk(sk1)->inet_dport);
    //    if (port != 80) {
    //        return;
    //    }
    //    //printk("do_ip_output dport: %d\n", port);
    //}

    struct sock *sk1 = skb->sk;
    if (!sk1) {
        return;
    }

	struct stap_info *info = sk1->sk_user_data;
	if (!info) {
		return;
    }
    printk("do_ip_output\n");
%}

probe ipvs.ip_finish_output =
    kernel.statement("ip_finish_output2@ip_output.c:230")
{
    do_ip_finish_output2($sk, $skb, $neigh);
}

function do_ip_finish_output2(sk:long, skb:long, neigh:long)
%{
	struct sock *sk = (struct sock *)STAP_ARG_sk;
    struct neighbour *neigh = (struct neighbour*)STAP_ARG_neigh;

	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;
    if (!skb) {
        return;
    }

    struct sock *sk1 = skb->sk;
    if (!sk1) {
        return;
    }

	struct stap_info *info = sk1->sk_user_data;
	if (!info) {
		return;
    }

    if (neigh) {
        printk("neigh is not null\n");
    }
%}

probe ipvs.dev_queue_xmit =
    kernel.function("dev_queue_xmit")
{
    do_dev_queue_xmit($skb)
}

function do_dev_queue_xmit(skb:long)
%{
	struct sk_buff *skb = (struct sk_buff *)STAP_ARG_skb;
    if (!skb) {
        return;
    }

    struct sock *sk1 = skb->sk;
    if (!sk1) {
        return;
    }

	struct stap_info *info = sk1->sk_user_data;
	if (!info) {
		return;
    }

    printk("dev_queue_xmit skb\n");
%}

