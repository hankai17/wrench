probe ipvs.dev_queue_xmit =
    kernel.function("dev_queue_xmit")
{
    if (!$skb) next;

    sk = $skb->sk;
    if (!sk) next;

    info = sk->sk_user_data;
    if (!info) next;

    printf("dev_queue_xmit skb\n");
}

